PORT=5000
NODE_ENV=development

# PostgreSQL connection (replace with your actual DB credentials)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/taskflow_pro"

# JWT Secrets (change these in production!)
JWT_SECRET=taskflow_super_secret_jwt_2026_change_me
JWT_REFRESH_SECRET=taskflow_refresh_secret_2026_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4200

# File uploads
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads
