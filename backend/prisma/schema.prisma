// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ─────────────────────────────────────────
//  ROLES & PERMISSIONS
// ─────────────────────────────────────────
model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique // SUPERADMIN | ADMIN | MANAGER | SUPERVISOR | EMPLOYEE
  nameAr      String
  level       Int          // 1=SUPERADMIN 5=EMPLOYEE
  permissions Permission[]
  users       User[]

  @@map("tbl_Roles")
}

model Permission {
  id       Int     @id @default(autoincrement())
  roleId   Int
  module   String  // USERS | TASKS | DEPARTMENTS | REPORTS | AUDIT
  canCreate  Boolean @default(false)
  canRead    Boolean @default(true)
  canUpdate  Boolean @default(false)
  canDelete  Boolean @default(false)
  canAssign  Boolean @default(false)
  canReport  Boolean @default(false)

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, module])
  @@map("tbl_Permissions")
}

// ─────────────────────────────────────────
//  DEPARTMENTS (Self-referencing hierarchy)
// ─────────────────────────────────────────
model Department {
  id             Int          @id @default(autoincrement())
  name           String
  nameAr         String
  code           String       @unique // DEP-HR, DEP-IT, etc.
  parentId       Int?
  managerId      Int?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  parent         Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DeptHierarchy")
  users          User[]
  manager        User?        @relation("DeptManager", fields: [managerId], references: [id])

  @@map("tbl_Departments")
}

// ─────────────────────────────────────────
//  USERS / EMPLOYEES
// ─────────────────────────────────────────
model User {
  id               Int       @id @default(autoincrement())
  employeeCode     String    @unique // EMP-2026-001
  fullName         String
  fullNameAr       String
  username         String    @unique
  passwordHash     String
  plainPassword    String?   // stored for admin reference only
  email            String    @unique
  phone            String?
  departmentId     Int?
  roleId           Int
  managerId        Int?      // Self-reference
  isActive         Boolean   @default(true)
  isFirstLogin     Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  profilePhoto     String?
  preferredLang    String    @default("ar") // ar | en
  telegramChatId   String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?
  resetToken       String?
  resetTokenExpiry DateTime?

  role             Role       @relation(fields: [roleId], references: [id])
  department       Department? @relation(fields: [departmentId], references: [id])
  manager          User?      @relation("UserManager", fields: [managerId], references: [id])
  subordinates     User[]     @relation("UserManager")
  managedDepts     Department[] @relation("DeptManager")

  // Task relations
  tasksAssigned    Task[]     @relation("TaskAssignee")
  tasksCreated     Task[]     @relation("TaskCreator")
  taskComments     TaskComment[]
  statusChanges    TaskStatusHistory[]
  notifications    Notification[] @relation("NotifReceiver")
  sentNotifications Notification[] @relation("NotifSender")
  auditLogs        AuditLog[]
  transferHistory  EmployeeTransfer[]
  timeEntries      TimeEntry[]
  points           UserPoint[]
  createdExtracts  TaskExtract[]  @relation("ExtractCreator") // ← NEW

  // Chat relations
  convAsUser1      ChatConversation[] @relation("ConvUser1")
  convAsUser2      ChatConversation[] @relation("ConvUser2")
  sentMessages     ChatMessage[]      @relation("ChatSender")
  pushSubscriptions PushSubscription[] // ← Web Push

  @@map("tbl_Users")
}

model EmployeeTransfer {
  id              Int        @id @default(autoincrement())
  userId          Int
  fromDeptId      Int
  toDeptId        Int
  transferDate    DateTime   @default(now())
  note            String?
  transferredById Int

  user User @relation(fields: [userId], references: [id])

  @@map("tbl_EmployeeTransfers")
}

// ─────────────────────────────────────────
//  PUSH SUBSCRIPTIONS (Web Push Notifications)
// ─────────────────────────────────────────
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tbl_PushSubscriptions")
}

// ─────────────────────────────────────────
//  TASKS
// ─────────────────────────────────────────
model TaskCategory {
  id     Int    @id @default(autoincrement())
  name   String // IT | HR | Finance | Marketing | Admin | Other
  nameAr String
  color  String @default("#2E86AB")
  icon   String @default("task_alt")
  tasks  Task[]

  @@map("tbl_TaskCategories")
}

// Enums replaced with String for SQLite compatibility

model Task {
  id              Int          @id @default(autoincrement())
  taskCode        String       @unique // TSK-2026-0001
  title           String
  titleAr         String?
  description     String?
  categoryId      Int?
  priority        String       @default("MEDIUM")
  status          String       @default("NEW")
  assignedToId    Int
  createdById     Int
  startDate       DateTime?
  dueDate         DateTime?
  completedDate   DateTime?
  progressPercent Int          @default(0)
  isArchived      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  category        TaskCategory?      @relation(fields: [categoryId], references: [id])
  assignedTo      User               @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdBy       User               @relation("TaskCreator", fields: [createdById], references: [id])
  statusHistory   TaskStatusHistory[]
  comments        TaskComment[]
  attachments     TaskAttachment[]
  notifications   Notification[]
  checklist       TaskChecklist[]
  timeEntries     TimeEntry[]
  tags            TaskTag[]
  extracts        TaskExtract[]   // ← NEW: extracts linked to this task
  
  dependsOnId     Int?
  dependsOn       Task?              @relation("TaskDependencies", fields: [dependsOnId], references: [id])
  dependentTasks  Task[]             @relation("TaskDependencies")

  @@map("tbl_Tasks")
}

model TaskStatusHistory {
  id           Int        @id @default(autoincrement())
  taskId       Int
  fromStatus   String?
  toStatus     String
  changedById  Int
  changeDate   DateTime   @default(now())
  note         String?

  task         Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedBy    User @relation(fields: [changedById], references: [id])

  @@map("tbl_TaskStatusHistory")
}

model TaskComment {
  id            Int          @id @default(autoincrement())
  taskId        Int
  userId        Int
  commentText   String
  commentDate   DateTime     @default(now())
  isManagerNote Boolean      @default(false)
  isReturnNote  Boolean      @default(false)  // ← NEW: marks extract return comments
  extractId     Int?                           // ← NEW: links comment to a specific extract

  task    Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id])
  extract TaskExtract? @relation(fields: [extractId], references: [id])

  @@map("tbl_TaskComments")
}

model TaskAttachment {
  id           Int      @id @default(autoincrement())
  taskId       Int
  fileName     String
  fileUrl      String
  fileSize     Int
  fileType     String
  uploadedById Int
  uploadedAt   DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("tbl_Attachments")
}

// ─────────────────────────────────────────
//  NOTIFICATIONS
// ─────────────────────────────────────────
// Enums replaced with String for SQLite compatibility

model Notification {
  id               Int              @id @default(autoincrement())
  receiverId       Int
  senderId         Int?
  taskId           Int?
  type             String
  title            String
  titleAr          String
  message          String
  messageAr        String
  isRead           Boolean          @default(false)
  createdAt        DateTime         @default(now())

  receiverUser User  @relation("NotifReceiver", fields: [receiverId], references: [id])
  senderUser   User? @relation("NotifSender",   fields: [senderId], references: [id])
  task         Task? @relation(fields: [taskId], references: [id])

  @@map("tbl_Notifications")
}

// ─────────────────────────────────────────
//  AUDIT LOG
// ─────────────────────────────────────────
model AuditLog {
  id             Int      @id @default(autoincrement())
  userId         Int?
  action         String   // LOGIN | CREATE_TASK | DELETE_USER | etc.
  tableAffected  String?
  recordId       Int?
  oldValues      String?  // JSON string
  newValues      String?  // JSON string
  ipAddress      String?
  userAgent      String?
  actionDate     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("tbl_AuditLog")
}

// ─────────────────────────────────────────
//  TASK CHECKLIST (Sub-tasks)
// ─────────────────────────────────────────
model TaskChecklist {
  id          Int       @id @default(autoincrement())
  taskId      Int
  text        String
  textAr      String?
  isCompleted Boolean   @default(false)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("tbl_TaskChecklists")
}

// ─────────────────────────────────────────
//  TASK TEMPLATES
// ─────────────────────────────────────────
model TaskTemplate {
  id              Int       @id @default(autoincrement())
  name            String
  nameAr          String?
  description     String?
  categoryId      Int?
  priority        String    @default("MEDIUM")
  defaultDuration Int?      // days
  checklistItems  String?   // JSON array of {text, textAr}
  isGlobal        Boolean   @default(false)
  createdById     Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("tbl_TaskTemplates")
}

// ─────────────────────────────────────────
//  TIME TRACKING
// ─────────────────────────────────────────
model TimeEntry {
  id        Int       @id @default(autoincrement())
  taskId    Int
  userId    Int
  startTime DateTime
  endTime   DateTime?
  duration  Int?      // minutes
  note      String?
  createdAt DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("tbl_TimeEntries")
}

// ─────────────────────────────────────────
//  TASK TAGS
// ─────────────────────────────────────────
model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  nameAr    String?
  color     String    @default("#6366f1")
  taskTags  TaskTag[]

  @@map("tbl_Tags")
}

model TaskTag {
  taskId Int
  tagId  Int

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("tbl_TaskTags")
}

// ─────────────────────────────────────────
//  GAMIFICATION — USER POINTS
// ─────────────────────────────────────────
model UserPoint {
  id          Int      @id @default(autoincrement())
  userId      Int
  points      Int
  reason      String   // TASK_COMPLETED | ON_TIME | EARLY | STREAK
  taskId      Int?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("tbl_UserPoints")
}

// ─────────────────────────────────────────
//  SYSTEM SETTINGS
// ─────────────────────────────────────────
model SystemSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("tbl_SystemSettings")
}

// ─────────────────────────────────────────
//  CHAT — CONVERSATIONS & MESSAGES
// ─────────────────────────────────────────
model ChatConversation {
  id           Int           @id @default(autoincrement())
  user1Id      Int
  user2Id      Int
  lastMessage  String?
  lastAt       DateTime?
  createdAt    DateTime      @default(now())

  user1        User          @relation("ConvUser1", fields: [user1Id], references: [id])
  user2        User          @relation("ConvUser2", fields: [user2Id], references: [id])
  messages     ChatMessage[]

  @@unique([user1Id, user2Id])
  @@map("tbl_ChatConversations")
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  senderId       Int
  text           String
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation("ChatSender", fields: [senderId], references: [id])

  @@map("tbl_ChatMessages")
}

// ─────────────────────────────────────────
//  CONTRACTORS (مقاولين)
// ─────────────────────────────────────────
model Contractor {
  id        Int      @id @default(autoincrement())
  code      String?  @unique                // ← NEW: كود فريد للمقاول
  name      String
  nameAr    String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  extracts  TaskExtract[]

  @@map("tbl_Contractors")
}

// ─────────────────────────────────────────
//  PROJECTS (مشاريع)
// ─────────────────────────────────────────
model Project {
  id        Int      @id @default(autoincrement())
  name      String
  nameAr    String?
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  extracts  TaskExtract[]

  @@map("tbl_Projects")
}

// ─────────────────────────────────────────
//  TASK EXTRACTS (مستخلصات)
//  Status flow: RECEIVED → UNDER_REVIEW → POSTED
//               UNDER_REVIEW ↔ RETURNED (with mandatory comment)
//               POSTED → RETURNED (MANAGER+ only, with mandatory comment)
// ─────────────────────────────────────────
model TaskExtract {
  id            Int      @id @default(autoincrement())
  extractNumber Int
  taskId        Int?
  contractorId  Int
  projectId     Int
  status        String   @default("RECEIVED") // RECEIVED|UNDER_REVIEW|POSTED|RETURNED
  amount        Decimal? @db.Decimal(15, 2)   // ← المبلغ المالي للمستخلص
  currency      String   @default("EGP")      // ← العملة (EGP, USD, EUR, SAR...)
  notes         String?
  receivedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   Int

  task        Task?       @relation(fields: [taskId], references: [id])
  contractor  Contractor  @relation(fields: [contractorId], references: [id])
  project     Project     @relation(fields: [projectId], references: [id])
  createdBy   User        @relation("ExtractCreator", fields: [createdById], references: [id])
  comments    TaskComment[]

  @@map("tbl_TaskExtracts")
}
